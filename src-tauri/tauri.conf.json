{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panto Studio",
  "version": "0.1.0",
  "identifier": "com.panto.studio",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Panto Studio",
        "width": 560,
        "height": 685,
        "minWidth": 560,
        "minHeight": 685,
        "maxWidth": 560,
        "maxHeight": 685,
        "resizable": false,
        "maximizable": false,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 27 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../assets/icons/panto-srt.icns",
      "../assets/icons/panto-srt.png"
    ],
    "category": "public.app-category.video",
    "resources": {
      "../build/whisper/whisper-cli": "whisper/whisper-cli",
      "../build/whisper/lib": "whisper/lib",
      "../build/nemo": "nemo",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../build/esrgan/realesrgan-ncnn-vulkan": "esrgan/realesrgan-ncnn-vulkan",
      "../build/esrgan/models/realesr-animevideov3-x2.param": "esrgan/models/realesr-animevideov3-x2.param",
      "../build/esrgan/models/realesr-animevideov3-x2.bin": "esrgan/models/realesr-animevideov3-x2.bin",
      "../build/esrgan/models/realesr-animevideov3-x4.param": "esrgan/models/realesr-animevideov3-x4.param",
      "../build/esrgan/models/realesr-animevideov3-x4.bin": "esrgan/models/realesr-animevideov3-x4.bin"
    },
    "macOS": {
      "minimumSystemVersion": "13.4"
    }
  }
}
